# Copier en .env puis compléter. Ce fichier contient des secrets : ne jamais le partager ni le commiter.
# Générer les deux secrets :  docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c \"import secrets;from cryptography.fernet import Fernet;print('NEXA_JWT_SECRET='+secrets.token_urlsafe(48));print('NEXA_FILE_KEY='+Fernet.generate_key().decode())\""

NEXA_JWT_SECRET=
# ⚠ Clé de chiffrement des pièces ET des sauvegardes. La perdre = tout perdre. À copier dans un coffre (Bitwarden, 1Password…).
NEXA_FILE_KEY=

# Propriétaire du dossier ./data sur le NAS (commande `id` en SSH ; souvent 1026:100 sur Synology)
NEXA_UID=1026
NEXA_GID=100
NEXA_PORT_LOCAL=8000

# Test en HTTP sur le réseau local uniquement : mettre 0. Avec le tunnel HTTPS : laisser 1.
NEXA_COOKIE_SECURE=1

# Derrière Cloudflare Tunnel : "*" (le conteneur n'est joignable que par le tunnel et le réseau local)
NEXA_FORWARDED_ALLOW_IPS=127.0.0.1

# Nombre de sauvegardes quotidiennes conservées
NEXA_SAUVEGARDE_CONSERVER=30

# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels), seulement pour l'accès Internet
CLOUDFLARE_TUNNEL_TOKEN=
